{
  "name": "agent-skills-resource-library",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "guides:generate": "node scripts/generate-guides.mjs",
    "predev": "npm run guides:generate",
    "dev": "next dev",
    "prebuild": "npm run guides:generate",
    "build": "next build",
    "prebuild:pages": "npm run guides:generate",
    "build:pages": "GITHUB_PAGES=true next build",
    "start": "next start",
    "data:duplicates": "node scripts/sync-duplicate-urls.mjs",
    "resources:override": "node .agents/skills/import-resource-overrides/scripts/import-resource-overrides.mjs",
    "test": "npm run test:data && npm run test:overrides && npm run test:copy && npm run build && npm run test:links",
    "test:copy": "node --test tests/featured-copy.test.mjs",
    "test:data": "node scripts/validate-data.mjs",
    "test:overrides": "node --test tests/import-resource-overrides.test.mjs",
    "test:links": "node --test tests/rendered-html.test.mjs tests/link-integrity.test.mjs",
    "test:links:external": "CHECK_EXTERNAL_LINKS=true npm run test:links",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
